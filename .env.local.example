NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Servidor MCP (control por chat)
# Service role key de Supabase (Settings > API). NUNCA exponer en el cliente.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
# user_id (UUID) del usuario en auth.users que posee los datos
FINANCE_USER_ID=tu-user-uuid
# Token secreto para autenticar el endpoint MCP (generá uno largo y aleatorio)
MCP_AUTH_TOKEN=un-token-largo-y-secreto
# Secreto para el Vercel Cron (recurrencia de gastos anuales). Vercel lo envía
# automáticamente como Bearer si está configurado en el proyecto.
CRON_SECRET=otro-token-largo-y-secreto
